
name: Build My AI Video Studio APK

on:
  workflow_dispatch:
  push:
    branches:
      - main

permissions:
  contents: read

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Setup Java
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Setup Android SDK
        uses: android-actions/setup-android@v4
        with:
          packages: 'platform-tools'

      - name: Extract Android project
        run: |
          mkdir -p project
          unzip -q my-ai-video-studio.zip -d project

      - name: Install Gradle
        run: |
          wget -q https://services.gradle.org/distributions/gradle-9.3.1-bin.zip
          unzip -q gradle-9.3.1-bin.zip

      - name: Find Android project
        run: |
          if [ -f project/settings.gradle ] || [ -f project/settings.gradle.kts ]; then
            echo "PROJECT_DIR=project" >> "$GITHUB_ENV"
          else
            DIR=$(find project -maxdepth 4 -type f \( -name settings.gradle -o -name settings.gradle.kts \) | head -n 1)
            if [ -z "$DIR" ]; then
              echo "Android project settings file not found"
              exit 1
            fi
            echo "PROJECT_DIR=$(dirname "$DIR")" >> "$GITHUB_ENV"
          fi

      - name: Build APK
        run: |
          ./gradle-9.3.1/bin/gradle --no-daemon -p "$PROJECT_DIR" assembleDebug

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: My-AI-Video-Studio-APK
          path: project/**/build/outputs/apk/debug/*.apk
          if-no-files-found: error
